# Phase 2 cloud sync (optional — the app runs fully offline/local-only
# without these). Copy to .env.local (gitignored) and fill in from your
# Firebase project's console: Project settings -> General -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The one shared stall login (Authentication -> Users in the console).
# Its password is the "PIN" sellers type at the gate — never put the
# password itself in this file or anywhere in the repo.
VITE_STALL_EMAIL=
