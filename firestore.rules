rules_version = '2';

// Phase 2 stopgap access gate: any signed-in user (the one shared stall
// email/password account, see src/sync/pinGate.ts) has full read/write to
// every shared collection. This is deliberately not per-person access
// control — that's Phase 3, once real accounts exist.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
